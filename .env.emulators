# Local development against the Firebase emulators. These values are fake and safe to commit:
# the emulators never contact Google, so no credentials are needed on a new machine.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-housely.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-housely
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
