{
  "name": "housely",
  "private": true,
  "version": "0.0.0",
  "description": "Organize a shared flat: a fair weekly chore rotation, completion tracking and a Tricount link, as an installable offline PWA.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Glinbor10",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glinbor10/housely.git"
  },
  "homepage": "https://github.com/Glinbor10/housely#readme",
  "bugs": {
    "url": "https://github.com/Glinbor10/housely/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "npx -y firebase-tools@15.34.0 --config firebase/firebase.json emulators:exec --only auth,firestore --ui --project demo-housely \"vite --mode emulators\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint -c config/oxlint.json",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "npx -y firebase-tools@15.34.0 --config firebase/firebase.json emulators:exec --only auth,firestore --project demo-housely \"vitest run --config firebase/firestore/vitest.config.ts\"",
    "dev:ci": "vite --mode ci",
    "test:coverage": "vitest run --coverage",
    "icons": "node scripts/generate-icons.mjs",
    "e2e": "playwright test -c e2e/deployed.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "e2e:emulator": "npx -y firebase-tools@15.34.0 --config firebase/firebase.json emulators:exec --only auth,firestore --project demo-housely \"playwright test -c e2e/emulator.config.ts\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "archunit": "^2.5.4",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "oxlint -c config/oxlint.json",
      "vitest related --run --passWithNoTests"
    ],
    "*.{json,md,css,html,yml,yaml,mjs}": [
      "prettier --write"
    ]
  }
}
