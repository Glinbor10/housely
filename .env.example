# Firebase web config for local development. Copy to .env.local (git-ignored) and fill in.
# CI and production values come from the GitHub Environments "ci" and "production".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
